# ========================================
# Default Text Handling
# ========================================
* text=auto
# ========================================
# Unity Text-Based Assets
# ========================================
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.anim text eol=lf
*.playable text eol=lf
*.meta text eol=lf
# ========================================
# Source Code / Configuration
# ========================================
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
# ========================================
# Git LFS: 3D Model Files
# ========================================
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
# ========================================
# Git LFS: Large Texture Sources
# ========================================
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
# ========================================
# Git LFS: Video Files
# ========================================
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
# ========================================
# Optional: Large Binary Resources
# ========================================
# Enable if these formats contain large files.
# *.tga filter=lfs diff=lfs merge=lfs -text
# *.hdr filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.jpeg filter=lfs diff=lfs merge=lfs -text
Assets/Scenes/SampleScene.unity filter=lfs diff=lfs merge=lfs -text
